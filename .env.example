# Supabase Configuration
# Copy this file to .env for local development:  cp .env.example .env

# Your Supabase project URL
# Find this in: Supabase Dashboard > Project Settings > API Keys
SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable default key
# Find this in: Supabase Dashboard > Project Settings > API Keys > Publishable
SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxx

# Supabase secret key
# Find this in: Supabase Dashboard > Project Settings > API Keys > Secret
# WARNING: This key bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SECRET_KEY=your-secret-key-here
